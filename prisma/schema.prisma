// BEM THE LIONS — Abidjan — Recrutement basketball 2026-2027
// SQLite en développement. Pour la production, passer provider à "postgresql"
// et renseigner DATABASE_URL (voir .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Candidats au recrutement.
/// status : null tant qu'aucune décision n'a été prise, puis "RETENU" ou "NON_RETENU".
/// Aucun autre statut n'existe.
model Candidate {
  id               String    @id @default(cuid())
  candidateNumber  String    @unique @map("candidate_number")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  gender           String // "HOMME" | "FEMME"
  studyYear        String    @map("study_year")
  fieldOfStudy     String    @map("field_of_study")
  phone            String    @unique // normalisé, ex. +2250700000000
  email            String    @unique // en minuscules
  qrCode           String    @unique @map("qr_code") // contenu encodé dans le QR Code
  registrationDate DateTime  @default(now()) @map("registration_date")
  status           String?   // "RETENU" | "NON_RETENU" | null
  evaluation       String?   // JSON : notes par critère (voir src/modules/recruitment/evaluation.ts)
  notes            String?   // Observations du responsable (jamais exposées au public)
  evaluatedAt      DateTime? @map("evaluated_at")
  evaluatedBy      String?   @map("evaluated_by")
  decidedAt        DateTime? @map("decided_at")
  decidedBy        String?   @map("decided_by")
  firstScannedAt   DateTime? @map("first_scanned_at")
  lastScannedAt    DateTime? @map("last_scanned_at")
  scanCount        Int       @default(0) @map("scan_count")
  consentAt        DateTime  @map("consent_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([lastName, firstName])
  @@map("candidates")
}

/// Paramètres de l'application (une seule ligne, id = 1).
model Settings {
  id                  Int      @id @default(1)
  teamName            String   @default("BEM THE LIONS") @map("team_name")
  city                String   @default("Abidjan")
  season              String   @default("2026-2027")
  teamMembersCount    Int      @default(5) @map("team_members_count")
  winsCount           Int      @default(6) @map("wins_count")
  lossesCount         Int      @default(4) @map("losses_count")
  previousSeason      String   @default("2025-2026") @map("previous_season")
  whatsappGroupLink   String   @default("") @map("whatsapp_group_link")
  responsibleName     String   @default("") @map("responsible_name")
  responsibleWhatsapp String   @default("") @map("responsible_whatsapp")
  responsiblePhone    String   @default("") @map("responsible_phone")
  coachName           String   @default("") @map("coach_name")
  coachWhatsapp       String   @default("") @map("coach_whatsapp")
  coachPhone          String   @default("") @map("coach_phone")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// Compteur atomique pour générer les numéros candidats (BEM-2026-0001, ...).
model Counter {
  key   String @id
  value Int    @default(0)

  @@map("counters")
}

/// Comptes de l'espace administrateur.
/// role : "ADMIN" (tous les droits) | "EVALUATOR" (scan + évaluation, sans décision ni paramètres).
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         String    @default("ADMIN")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("admin_users")
}

/// Journal des actions sensibles (décisions, modifications, paramètres).
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String   @map("actor_id")
  actorEmail  String   @map("actor_email")
  action      String
  targetId    String?  @map("target_id")
  details     String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([targetId])
  @@map("audit_logs")
}

